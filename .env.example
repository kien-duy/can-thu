# Chép thành .env.local (hoặc đặt trên host). Chạy trên máy thì không cần biến nào.

# Postgres khi lên mạng (Neon). Bỏ trống: PGlite lưu ở .data/pglite, không phải cài gì.
DATABASE_URL=
# Neon: URL đi thẳng (không có "-pooler" trong host), dùng để chạy migration lúc khởi động.
DATABASE_URL_UNPOOLED=
# Đặt (giá trị gì cũng được) trên host xoá đĩa khi khởi động lại, ví dụ gói miễn phí của Render.
REQUIRE_DATABASE_URL=
# Thư mục PGlite khi không có DATABASE_URL; "memory" là không lưu gì (test, e2e).
PGLITE_DIR=

# Nút "Liên kết Google": OAuth client loại "Web application" trong Google Cloud, redirect URI
# http://localhost:5173/api/auth/google/callback (và <site>/api/auth/google/callback). Bỏ trống: không có nút.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Địa chỉ công khai của site khi đứng sau proxy hoặc tunnel. Thường không cần.
PUBLIC_URL=

# Server production (npm start)
PORT=8787
HOST=0.0.0.0
